# Supabase（必須）
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# 管理画面ルート（現行の app/ops-819a1ec26e72 と一致させる）
NEXT_PUBLIC_ADMIN_PATH=ops-819a1ec26e72

# 保存済みAPIキーの保護（本番では必須）
SETTINGS_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# 外部APIのサーバー側フォールバック（任意）
EDINET_API_KEY=
ANTHROPIC_API_KEY=

# 開発用ワンクリックログイン（任意・本番では設定しない）
NEXT_PUBLIC_DEV_LOGIN_USER_EMAIL=
NEXT_PUBLIC_DEV_LOGIN_USER_PASSWORD=
NEXT_PUBLIC_DEV_LOGIN_ADMIN_EMAIL=
NEXT_PUBLIC_DEV_LOGIN_ADMIN_PASSWORD=
